{
  "doctype": "DocType",
  "name": "Pulse Request",
  "module": "Pulse",
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "title",
    "project",
    "description",
    "status",
    "reviewer",
    "duplicate_of",
    "accepted_task",
    "review_note",
    "activity"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project",
      "reqd": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Incoming\nDeferred\nRejected\nDuplicate\nAccepted",
      "default": "Incoming",
      "reqd": 1
    },
    {
      "fieldname": "reviewer",
      "fieldtype": "Link",
      "label": "Reviewer",
      "options": "User"
    },
    {
      "fieldname": "duplicate_of",
      "fieldtype": "Link",
      "label": "Duplicate of",
      "options": "Pulse Request"
    },
    {
      "fieldname": "accepted_task",
      "fieldtype": "Link",
      "label": "Accepted task",
      "options": "Task",
      "read_only": 1
    },
    {
      "fieldname": "review_note",
      "fieldtype": "Small Text",
      "label": "Review note"
    },
    {
      "fieldname": "activity",
      "fieldtype": "Table",
      "label": "History",
      "options": "Pulse Request Activity",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Admin",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Manager",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Team Lead",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Senior Developer",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Junior Developer",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Intern",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Pulse Viewer",
      "read": 1
    }
  ]
}
